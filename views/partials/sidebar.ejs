<header class="mobile-topbar">
  <div class="auth-brand" style="margin:0;">
    <div class="logo-mark">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2 8 4-16 2 8h6"/></svg>
    </div>
    <div class="brand-text"><h1 style="font-size:15px;">HealthBox</h1></div>
  </div>
  <button class="hamburger" id="navToggle" aria-label="Open menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
</header>

<aside class="sidebar" id="sidebar">
  <div class="auth-brand">
    <div class="logo-mark">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2 8 4-16 2 8h6"/></svg>
    </div>
    <div class="brand-text">
      <h1>HealthBox</h1>
      <span>Family Monitoring</span>
    </div>
  </div>

  <nav>
    <ul class="nav-list">
      <li><a class="nav-link" data-page="dashboard" href="/dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        Checkup Dashboard
      </a></li>
      <li><a class="nav-link" data-page="history" href="/history">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 7v5l4 2"/></svg>
        History
      </a></li>
      <li><a class="nav-link" data-page="profile" href="/profile">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        My Profile
      </a></li>
    </ul>
  </nav>

  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="avatar" id="sidebarAvatar">?</div>
      <div class="user-meta">
        <strong id="sidebarName">Loading…</strong>
        <span id="sidebarEmail">&nbsp;</span>
      </div>
    </div>
    <button class="btn btn-secondary btn-block btn-sm" id="logoutBtn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign Out
    </button>
  </div>
</aside>
