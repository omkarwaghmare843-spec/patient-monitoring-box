<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js"></script>
</head>
<body>
  <div class="app-shell" id="appShell">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <div class="topbar">
        <div>
          <h1>Checkup History</h1>
          <p class="text-muted">Your past checkups and vitals trends over time.</p>
        </div>
      </div>

      <div class="chart-grid">
        <div class="card chart-card">
          <div class="card-header"><h3>Heart Rate Trend</h3></div>
          <canvas id="trend-hr"></canvas>
        </div>
        <div class="card chart-card">
          <div class="card-header"><h3>SpO&#8322; Trend</h3></div>
          <canvas id="trend-spo2"></canvas>
        </div>
        <div class="card chart-card">
          <div class="card-header"><h3>Temperature Trend</h3></div>
          <canvas id="trend-temp"></canvas>
        </div>
      </div>

      <h3 class="section-title">All Checkups</h3>
      <div class="card" id="tableCard">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Date &amp; Time</th>
                <th>Temp (°C)</th>
                <th>Heart Rate (bpm)</th>
                <th>SpO&#8322; (%)</th>
                <th>ECG (mV)</th>
                <th>EMG (&micro;V)</th>
              </tr>
            </thead>
            <tbody id="historyBody">
            </tbody>
          </table>
        </div>
        <div class="empty-state" id="emptyState" hidden>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 7v5l4 2"/></svg>
          <h4>No checkups yet</h4>
          <p>Go to the Dashboard, connect to your HealthBox, and save your first checkup.</p>
        </div>
      </div>
    </main>
  </div>

  <script type="module" src="/js/history.js"></script>
</body>
</html>
