rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each family member can only read/write their own profile document.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Each family member can only read/write their own checkup records.
      match /checkups/{checkupId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // checkups are immutable once saved
      }
    }
  }
}
