# Copy this file to .env and fill in your Firebase project credentials.
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup and configuration.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Session secret for express-session (any long random string)
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000
